# Proxy authentication — REQUIRED. Comma-separated for multiple keys. No default.
PROXY_API_KEY=change-me-to-a-long-random-secret

# Official upstream (RECOMMENDED): any authorized OpenAI-compatible endpoint.
# Example: OpenRouter, Together, local Ollama/LM Studio, your own gateway.
UPSTREAM_BASE_URL=https://api.example.com/v1
UPSTREAM_API_KEY=change-me-upstream-key

# Legacy unsupported Zen transport (reverse-engineered, for analysis only).
# Set to "true" ONLY if you understand it may break or violate provider terms.
# When set, UPSTREAM_BASE_URL is preferred if present.
ALLOW_ZEN_LEGACY=false

# Models actually configured on the upstream. Must match upstream model IDs.
# /v1/models returns exactly this list.
MODELS=deepseek-v4-flash-free,big-pickle,minimax-m2.5-free,nemotron-3-super-free,qwen3.6-plus-free

# Optional tuning
MAX_BODY_BYTES=2097152
UPSTREAM_TIMEOUT_MS=55000
RATE_LIMIT_PER_MINUTE=60
