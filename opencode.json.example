{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vercel-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vercel Proxy",
      "options": {
        "baseURL": "https://YOUR-PROJECT.vercel.app/v1"
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash (proxy)"
        },
        "big-pickle": {
          "name": "Big Pickle (proxy)"
        },
        "minimax-m2.5-free": {
          "name": "MiniMax M2.5 (proxy)"
        },
        "nemotron-3-super-free": {
          "name": "Nemotron 3 Super (proxy)"
        },
        "qwen3.6-plus-free": {
          "name": "Qwen 3.6 Plus (proxy)"
        }
      }
    }
  }
}
